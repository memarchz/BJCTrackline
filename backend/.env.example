# Neon Postgres connection string (pooled, for the app at runtime)
DATABASE_URL="postgresql://<user>:<password>@<host>/<db>?sslmode=require"
# Neon direct (unpooled) connection string, used by Prisma Migrate
DIRECT_URL="postgresql://<user>:<password>@<host>/<db>?sslmode=require"

# Secret used to sign JWTs — generate a long random string for real environments
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

PORT=4000
CORS_ORIGIN="http://localhost:3000"
# Base URL of the deployed frontend — used to build "View task" links in emails
FRONTEND_URL="http://localhost:3000"

# "today" anchor used to seed demo data (matches the design prototype); leave unset in production
SEED_TODAY="2026-07-24"

# Where task attachments are stored on disk. Downloads are streamed through
# an authenticated route (see GET /:id/attachments/:attachmentId/download),
# checked on every request — not a signed one-time URL.
# In production, point this at a path OUTSIDE the app's own deploy/release
# directory — ideally a persistent volume — so uploads survive redeploys and
# aren't wiped when a new release is unpacked, e.g.:
#   UPLOADS_DIR="/var/lib/bjc-trackline/uploads"
# Leave unset for local dev — defaults to ./uploads next to the running process.
# UPLOADS_DIR="/var/lib/bjc-trackline/uploads"

# SMTP — used to email assignees when a task owner nudges them. Optional:
# leave unset and email sending is skipped (with a console warning) rather
# than failing the request.
#
# Using Gmail SMTP (free, ~500 emails/day):
#   1. Turn on 2-Step Verification on the Google account that will send mail:
#      https://myaccount.google.com/security
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#      (pick app "Mail", any device name) — copy the 16-character password.
#   3. Use the values below, with SMTP_USER as the full Gmail address and
#      SMTP_PASS as that 16-character App Password (NOT your normal Gmail
#      login password — that will not work here).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-address@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="BJC Trackline <your-address@gmail.com>"
