# Claude Code local state — settings, session data, and any worktrees
# created during agent runs (these can contain full duplicate checkouts).
.claude/
**/.claude/

# Stray local binary, not part of the project.
claude.exe

# AI-agent instruction files — internal tooling notes, not project docs
# (README.md files and other real documentation are still tracked).
CLAUDE.md
AGENTS.md
**/CLAUDE.md
**/AGENTS.md

# Dependencies / build output (frontend and backend also have their own
# .gitignore, but keep this here too since git init is at the repo root).
node_modules/
dist/
.next/
out/
build/

# Env files — never commit real credentials.
.env
.env.local
.env.*.local
!.env.example

*.log
.DS_Store
*.tsbuildinfo

# Microsoft Office temp/lock files (created while a .docx/.xlsx is open).
~$*
